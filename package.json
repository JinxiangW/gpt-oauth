{
  "name": "dsh-llm-openai",
  "version": "0.2.0",
  "description": "ChatGPT subscription OAuth and GPT model adapter for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./login": "./login.mjs"
  },
  "bin": {
    "dsh-openai-login": "login.mjs"
  },
  "files": [
    "index.js",
    "login.mjs",
    "oauth-store.mjs",
    "proxy.mjs",
    "smoke-test.mjs",
    "link-to-dsh.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check login.mjs && node --check oauth-store.mjs && node --check proxy.mjs && node --check smoke-test.mjs",
    "test": "node --test test/security.test.mjs test/smoke.test.mjs",
    "smoke": "node smoke-test.mjs",
    "smoke:catalog": "node smoke-test.mjs --no-call"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-ai": "0.82.1",
    "undici": "6.21.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinxiangW/gpt-oauth.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
