{
  "name": "dsh-llm-openai",
  "version": "0.4.0",
  "description": "ChatGPT subscription OAuth and GPT model adapter for DeepSeek Harness (dsh 0.2.0-rc.2 architecture)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./login": "./login.mjs",
    "./boot-log": "./boot-log.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-openai-login": "login.mjs"
  },
  "files": [
    "index.js",
    "auth.mjs",
    "boot-log.mjs",
    "codex-catalog.mjs",
    "login.mjs",
    "desktop-login.mjs",
    "oauth-store.mjs",
    "proxy.mjs",
    "smoke-test.mjs",
    "cordis.patch.yml",
    "link-to-dsh.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check codex-catalog.mjs && node --check auth.mjs && node --check login.mjs && node --check oauth-store.mjs && node --check proxy.mjs && node --check smoke-test.mjs && npm --prefix packages/dsh-web-openai-codex run check",
    "test": "node --test test/*.test.mjs && npm --prefix packages/dsh-web-openai-codex test",
    "smoke": "node smoke-test.mjs",
    "smoke:catalog": "node smoke-test.mjs --no-call"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "undici": "6.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-authorization": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinxiangW/gpt-oauth.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
